{
  "name": "italk",
  "version": "1.0.0",
  "description": "iTalk - Ứng dụng Luyện Nghe-Nói & Shadowing Đa Ngôn Ngữ (Nhật, Trung, Việt) trên Web & Electron Desktop",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "electron electron/main.cjs --no-sandbox",
    "build:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.italk.app",
    "productName": "iTalk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
